<?xml version="1.0" encoding="UTF-8"?>
<!--
    Valid for PHPUnit 8.5, 9.6, 10.5 and 11.5 alike: no schema location and
    only elements and attributes that all four versions understand. Notices,
    warnings and deprecations are made fatal by the error handler that
    tests/bootstrap.php installs. The memory limit leaves room above the
    128M of a PHP without php.ini (the official images): the suite peaks
    near it on PHPUnit 8.5.
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    cacheResult="false"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <!-- Skipped unless tests/Integration/docker/run.sh starts the web servers. -->
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
