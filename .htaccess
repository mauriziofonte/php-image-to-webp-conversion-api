# Apache configuration for an installation whose directory is served as is
# (shared hosting, or 1.x-style installs in a subdirectory such as
# https://example.com/webp-converter/). Prefer pointing the document root
# at public/, which has its own .htaccess: then this file is never read.
#
# Every request is handed to public/index.php; no file of the installation
# (.env, vendor/, src/, ...) is ever served. Needs mod_rewrite and
# "AllowOverride FileInfo" (or All); without mod_rewrite every request is
# refused, never served as a file.

Options -Indexes -MultiViews
DirectoryIndex disabled

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The URL path of this directory when it is not the document root
    # ("/webp-converter/"), so that the routes are matched below it
    # (Mfonte\ImageConversionApi\Http\InstallationBase).
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=IMAGE_CONVERSION_API_BASE:%1/]

    # PHP-FPM behind mod_proxy_fcgi does not receive the Authorization
    # header otherwise: the API key travels as "Authorization: Bearer".
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%0]

    RewriteRule .* public/index.php [END]
</IfModule>

# httpoxy: a "Proxy" request header must not become HTTP_PROXY. The
# security headers come from PHP (a "Header always set" here would send
# them twice behind PHP-FPM).
<IfModule mod_headers.c>
    RequestHeader unset Proxy
</IfModule>
