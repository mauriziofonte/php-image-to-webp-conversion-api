# Configuration of the image conversion API. Comments start with "#" (";" is
# still accepted, as in the 1.x file).
#
# Every key is read from the environment first (env[KEY] in a PHP-FPM pool,
# SetEnv in Apache, -e or "environment:" with Docker), then from this file
# copied to .env at the root of the installation, which is optional. For every
# key, an unset variable, an empty value and "null" mean "not set". An invalid
# value makes every request answer 503 invalid_configuration, with the reason
# in the log. "composer check-env" (bin/image-conversion-api check-env)
# validates the configuration and the host before you deploy.

# Last path segment of the 1.x endpoint, which 2.x serves at /v1/{V1_SCRIPT_NAME}:
# letters, digits, ".", "_", "~" and "-". Not set: no /v1 endpoint.
# For example, for https://example.com/v1/converter it is "converter".
# 1.x called it SCRIPT_NAME, a name the web server already uses for every request.
# It is set to a random string here, so that you are forced to change it.
# The /v1 endpoint is deprecated, with a sunset on 2027-11-01: see the README.
V1_SCRIPT_NAME = "dsdsdydibvbisdbi732y83274268yuyusdyuvsdvyuvsuv"

# The API key, at least 16 bytes long, taken whole (commas included).
# Clients send it as "Authorization: Bearer <key>" or in the X-API-Key header.
# Without API_KEY and API_KEYS every protected endpoint answers 503.
API_KEY = "an example api key, very secret"

# More keys, separated by commas, each at least 16 bytes long, for
# rotation: add the new key, move the clients, then remove the old one.
#API_KEYS = ""

# Absolute path of the directory that receives the per-request temporary
# directories, outside the web root. Size it for at least
# CONCURRENCY_SLOTS x (MAX_BODY_BYTES + 256 MiB). Default: the system
# temporary directory.
#TEMP_DIR = "/var/tmp/image-conversion-api"

# IPs and CIDR blocks of the reverse proxies whose X-Forwarded-Proto and
# X-Forwarded-For headers are believed, separated by commas. Default: none.
#TRUSTED_PROXIES = "10.0.0.0/8, 2001:db8::1"

# Whether the protected endpoints refuse requests that did not arrive over
# HTTPS: true or false. Default: true. For local development over plain HTTP
# (http://localhost, a test container) set it to false; in production keep it
# on, and behind a TLS-terminating proxy list that proxy in TRUSTED_PROXIES.
#REQUIRE_HTTPS = "true"

# IPs and CIDR blocks of the clients allowed on the protected endpoints, in
# addition to the API key, separated by commas. Default: every client.
#IP_ALLOWLIST = "198.51.100.0/24, 2001:db8::/32"

# Longest time, in whole seconds (1 to 3600), that a conversion request may
# spend waiting for a conversion slot and converting. The library's
# processing ceiling is capped to what is left of it, so a conversion is
# stopped by the library (422 conversion_timeout) before the web server or
# PHP-FPM kills the worker. Keep it below nginx fastcgi_read_timeout, Apache
# Timeout/ProxyTimeout (60 s by default), PHP-FPM request_terminate_timeout
# and the client's timeout. Default: 50.
#CONVERSION_TIME_LIMIT = "50"

# Largest request body of the conversion endpoints, in bytes. A larger
# Content-Length is refused (413 body_too_large) before the body is read.
# Set PHP's post_max_size and upload_max_filesize to at least this value.
# Default: 22020096 (21 MiB).
#MAX_BODY_BYTES = "22020096"

# Largest image, in bytes (413 file_too_large). Default: 20971520 (20 MiB).
#MAX_IMAGE_BYTES = "20971520"

# Most images in one /v1 request (413 otherwise), 1 to 100. Default: 10.
# PHP's max_file_uploads must not be lower: PHP drops the files above it.
#V1_MAX_FILES = "10"

# Most conversions running at the same time on this host, 1 to 256, and the
# longest wait in seconds for a free slot (below CONVERSION_TIME_LIMIT),
# after which the request is answered 503 concurrency_limit with Retry-After.
# Each running conversion may need up to 2 GiB of memory: give the host at
# least CONCURRENCY_SLOTS x 2 GiB, plus the PHP workers and a tmpfs TEMP_DIR
# (docker/compose.yaml shows the sum). Defaults: 4 and 10.
#CONCURRENCY_SLOTS = "4"
#CONCURRENCY_WAIT = "10"

# Directory of the lock files of the conversion slots and of the file-based
# rate limiter: absolute, private to the PHP user, on a local filesystem and
# never cleaned while the service runs. Not TEMP_DIR, nor inside a directory
# of TEMP_DIR named "image-conversion-api-*", which the removal of stale
# request directories deletes. Prefer /run/image-conversion-api (created for
# the PHP user, mode 0700, by systemd's RuntimeDirectory= or tmpfiles.d) to a
# directory under /tmp, which systemd-tmpfiles cleans up by age.
# Default: TEMP_DIR/image-conversion-api.locks.
#LOCK_DIR = "/run/image-conversion-api"

# Requests per minute per API key on the conversion endpoints (0: no limit)
# and the burst a key may send at once; above them, 429 rate_limited with
# Retry-After. Defaults: 300 and 50.
#RATE_LIMIT = "300"
#RATE_LIMIT_BURST = "50"

# Where the rate limiter keeps its counters: apcu (needs ext-apcu), file (in
# LOCK_DIR, shared by every PHP process of the host) or auto (apcu when it is
# enabled, otherwise file). Default: auto.
#RATE_LIMIT_STORE = "auto"

# Where the counters of /metrics are kept: apcu, file (in LOCK_DIR), auto
# (apcu when it is enabled, otherwise file) or off. Default: auto.
#METRICS_STORE = "auto"

# More keys, separated by commas, each at least 16 bytes long, accepted on
# /metrics only: give one to the Prometheus scraper, so that it holds no key
# that converts images. The API keys are accepted on /metrics too.
#METRICS_KEYS = ""

# Directory where the conversion library keeps the backends and the isolation
# level it probed (probing takes seconds): absolute, private to the PHP user,
# writable. Set it when the root filesystem is read-only (the Docker image
# does). Default: the system temporary directory/secure-image-converter-<uid>.
#CONVERTER_CACHE_DIR = "/var/cache/image-conversion-api"

# Where the JSON log lines go: "stderr", or the absolute path of a file whose
# directory exists. Default: PHP's error_log().
#LOG_FILE = "stderr"

# Least severe level logged: debug, info, notice, warning, error, critical,
# alert or emergency. Default: info (one entry per request, and the refusals).
#LOG_LEVEL = "info"

