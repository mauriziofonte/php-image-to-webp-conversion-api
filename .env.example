; Configuration of the image conversion API. Comments start with ';', as in php.ini.
;
; The 2.x front controller, public/index.php, reads these keys from environment
; variables (env[KEY] in a PHP-FPM pool, SetEnv in Apache, -e with docker run);
; reading them from a .env file comes with API-7. For every key, an unset
; variable, an empty value and "null" mean "not set". An invalid value makes
; every request answer 503 invalid_configuration, with the reason in the log.

; Last path segment of the 1.x endpoint, which 2.x serves at /v1/{V1_SCRIPT_NAME}:
; letters, digits, ".", "_", "~" and "-". Not set: no /v1 endpoint.
; For example, for https://example.com/v1/converter it is "converter".
; 1.x called it SCRIPT_NAME, a name the web server already uses for every request.
; It is set to a random string here, so that you are forced to change it.
V1_SCRIPT_NAME = "dsdsdydibvbisdbi732y83274268yuyusdyuvsdvyuvsuv"
; The 1.x process.php, which API-5 removes, still reads the old name from .env:
;SCRIPT_NAME = "dsdsdydibvbisdbi732y83274268yuyusdyuvsdvyuvsuv"

; The API key, at least 16 characters long, taken whole (commas included).
; Clients send it as "Authorization: Bearer <key>" or in the X-API-Key header.
; Without API_KEY and API_KEYS every protected endpoint answers 503.
API_KEY = "an example api key, very secret"

; More keys, separated by commas, each at least 16 characters long, for
; rotation: add the new key, move the clients, then remove the old one.
;API_KEYS = ""

; Absolute path of the directory that receives the per-request temporary
; directories, outside the web root. Default: the system temporary directory.
;TEMP_DIR = "/var/tmp/image-conversion-api"

; IPs and CIDR blocks of the reverse proxies whose X-Forwarded-Proto and
; X-Forwarded-For headers are believed, separated by commas. Default: none.
;TRUSTED_PROXIES = "10.0.0.0/8, 2001:db8::1"

; Whether the protected endpoints refuse requests that did not arrive over
; HTTPS: true or false. Default: true.
;REQUIRE_HTTPS = "true"

; IPs and CIDR blocks of the clients allowed on the protected endpoints, in
; addition to the API key, separated by commas. Default: every client.
;IP_ALLOWLIST = "198.51.100.0/24, 2001:db8::/32"

; Longest time, in whole seconds (1 to 3600), that a conversion request may
; spend waiting for a conversion slot and converting. The library's
; processing ceiling is capped to what is left of it, so a conversion is
; stopped by the library (422 conversion_timeout) before the web server or
; PHP-FPM kills the worker. Keep it below nginx fastcgi_read_timeout, Apache
; Timeout/ProxyTimeout (60 s by default), PHP-FPM request_terminate_timeout
; and the client's timeout. Default: 50.
;CONVERSION_TIME_LIMIT = "50"

; Largest request body of the conversion endpoints, in bytes. A larger
; Content-Length is refused (413 body_too_large) before the body is read.
; Set PHP's post_max_size and upload_max_filesize to at least this value.
; Default: 22020096 (21 MiB).
;MAX_BODY_BYTES = "22020096"

; Largest image, in bytes (413 file_too_large). Default: 20971520 (20 MiB).
;MAX_IMAGE_BYTES = "20971520"

; Most images in one /v1 request (413 too_many_files), 1 to 100. Default: 10.
;V1_MAX_FILES = "10"

; Most conversions running at the same time on this host, 1 to 256, and the
; longest wait in seconds for a free slot (below CONVERSION_TIME_LIMIT),
; after which the request is answered 503 concurrency_limit with Retry-After.
; Defaults: 4 and 10.
;CONCURRENCY_SLOTS = "4"
;CONCURRENCY_WAIT = "10"

; Directory of the lock files of the conversion slots and of the file-based
; rate limiter: absolute, private to the PHP user, on a local filesystem and
; never cleaned while the service runs. Default: TEMP_DIR/image-conversion-api.locks.
;LOCK_DIR = "/run/image-conversion-api"

; Requests per minute per API key on the conversion endpoints (0: no limit)
; and the burst a key may send at once; above them, 429 rate_limited with
; Retry-After. Defaults: 300 and 50.
;RATE_LIMIT = "300"
;RATE_LIMIT_BURST = "50"

; Where the rate limiter keeps its counters: apcu (needs ext-apcu), file (in
; LOCK_DIR, shared by every PHP process of the host) or auto (apcu when it is
; enabled, otherwise file). Default: auto.
;RATE_LIMIT_STORE = "auto"
